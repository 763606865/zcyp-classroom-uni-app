<template>
	<RcNavBar title="登录" :show-back="true" :show-search="false" :show-scan="false" />
	<scroll-view class="login-page" scroll-y>
		<view class="login-header"><view class="brand"><text class="brand-text">中</text></view><text class="title">手机号登录</text><text class="subtitle">未注册手机号验证后将自动创建账号</text></view>
		<view class="login-card">
			<text class="field-label">手机号</text>
			<view v-if="useSavedPhone" class="saved-phone"><view><text class="saved-phone-value">{{ maskedPhone }}</text><text class="saved-phone-tip">验证码将发送到当前手机号</text></view><text class="change-phone" @click="changePhone">更换手机号</text></view>
			<input v-else v-model="phone" class="field" type="number" maxlength="11" placeholder="请输入中国大陆手机号" />
			<text class="field-label code-label">短信验证码</text>
			<view class="code-row"><input v-model="code" class="field code-field" type="number" maxlength="6" placeholder="请输入6位验证码" /><button class="code-button" :disabled="countdown > 0 || sending" @click="sendCode">{{ countdown > 0 ? countdown + 's' : '获取验证码' }}</button></view>
			<button class="login-button" :loading="submitting" :disabled="submitting" @click="submit">{{ useSavedPhone ? '当前手机号登录' : '登录 / 注册' }}</button>
			<view class="agreement" @click="agreed = !agreed"><view class="checkbox" :class="{ checked: agreed }"><text v-if="agreed" class="checkbox-mark">✓</text></view><text class="agreement-text">我已阅读并同意《用户协议》和《隐私政策》</text></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { phoneLogin, sendSmsCode } from '../../api/auth.uts'
	import RcNavBar from '../../components/RcNavBar.uvue'
	import { getLastLoginPhone, setSession } from '../../stores/auth.uts'

	const phone = ref(''); const code = ref(''); const agreed = ref(true); const sending = ref(false); const submitting = ref(false); const countdown = ref(0); const useSavedPhone = ref(false)
	const maskedPhone = computed(() : string => validPhone() ? phone.value.substring(0, 3) + '****' + phone.value.substring(7, 11) : '')
	let timer : number | null = null
	let redirect = '/pages/index/index'

	onLoad((options : UTSJSONObject) => {
		const value = options['redirect'] as string | null
		if (value != null && value != '') redirect = decodeURIComponent(value)
		// #ifdef APP
		const savedPhone = getLastLoginPhone()
		if (/^1\d{10}$/.test(savedPhone)) { phone.value = savedPhone; useSavedPhone.value = true }
		// #endif
	})
	onUnmounted(() => { if (timer != null) clearInterval(timer!) })

	function validPhone() : boolean { return /^1\d{10}$/.test(phone.value) }
	function showError(message : string) { uni.showToast({ title: message, icon: 'none' }) }
	function errorMessage(error : any | null, fallback : string) : string { if (error == null) return fallback; const cause = error as Error; return cause.message == '' ? fallback : cause.message }
	function changePhone() { useSavedPhone.value = false; phone.value = ''; code.value = ''; countdown.value = 0; if (timer != null) { clearInterval(timer!); timer = null } }

	function sendCode() {
		if (!validPhone()) { showError('请输入正确的手机号'); return }
		sending.value = true
		sendSmsCode(phone.value).then((result) => {
			countdown.value = result.expires_in > 60 ? 60 : result.expires_in
			timer = setInterval(() => { countdown.value--; if (countdown.value <= 0 && timer != null) { clearInterval(timer!); timer = null } }, 1000)
			uni.showToast({ title: result.message == '' ? '验证码已发送' : result.message, icon: 'success' }); sending.value = false
		}).catch((error : any | null) => { showError(errorMessage(error, '验证码发送失败')); sending.value = false })
	}

	function submit() {
		if (!validPhone()) { showError('请输入正确的手机号'); return }
		if (!/^\d{6}$/.test(code.value)) { showError('请输入6位验证码'); return }
		if (!agreed.value) { showError('请先同意用户协议和隐私政策'); return }
		submitting.value = true
		phoneLogin(phone.value, code.value).then((result) => {
			setSession(result); uni.showToast({ title: '登录成功', icon: 'success' })
			setTimeout(() => { uni.reLaunch({ url: redirect }) }, 300); submitting.value = false
		}).catch((error : any | null) => { showError(errorMessage(error, '登录失败')); submitting.value = false })
	}
</script>

<style scoped>
	.login-page{flex:1;background:#F5F7FA}.login-header{padding:72px 28px 32px;align-items:center}.brand{width:64px;height:64px;border-radius:20px;align-items:center;justify-content:center;background:#0F62FE}.brand-text{color:#fff;font-size:27px;font-weight:700}.title{margin-top:20px;font-size:24px;font-weight:700;color:#18352c}.subtitle{margin-top:8px;color:#7b8680;font-size:13px}.login-card{margin:0 20px;padding:26px 24px;border-radius:18px;background:#fff}.field-label{margin-bottom:9px;color:#354840;font-size:13px;font-weight:600}.saved-phone{height:58px;padding:0 14px;border-radius:10px;background:#F5F7FA;flex-direction:row;align-items:center;justify-content:space-between}.saved-phone-value{font-size:17px;font-weight:600;color:#263b34}.saved-phone-tip{margin-top:3px;font-size:10px;color:#8a9691}.change-phone{font-size:12px;color:#0F62FE}.code-label{margin-top:18px}.field{height:48px;padding:0 14px;border-radius:10px;background:#F5F7FA;font-size:15px}.code-row{flex-direction:row}.code-field{flex:1}.code-button{width:118px;height:48px;margin-left:10px;padding:0;line-height:48px;border-radius:10px;background:#E8F0FE;color:#0F62FE;font-size:13px}.login-button{margin-top:26px;height:48px;line-height:48px;border-radius:12px;background:#0F62FE;color:#fff;font-size:16px;font-weight:600}.agreement{margin-top:18px;flex-direction:row;align-items:center;justify-content:center}.checkbox{width:16px;height:16px;border:1px solid #c6ccd2;border-radius:4px;align-items:center;justify-content:center}.checkbox-mark{color:#fff;font-size:11px}.checked{background:#0F62FE;border-color:#0F62FE}.agreement-text{margin-left:7px;font-size:11px;color:#7b8188}
</style>
