<template>
	<scroll-view class="login-page" scroll-y>
		<view class="login-header">
			<view class="brand"><text class="brand-text">微</text></view>
			<text class="title">绑定手机号</text>
			<text class="subtitle">微信授权已通过，还需验证手机号才能完成登录</text>
		</view>

		<view class="login-card">
			<input v-model="phone" class="field" type="number" maxlength="11" placeholder="请输入手机号" />

			<view class="code-row">
				<input v-model="code" class="field code-field" type="number" maxlength="6" placeholder="6位验证码" />
				<button class="code-button" :disabled="countdown > 0 || sending" @click="sendCode">
					{{ countdown > 0 ? countdown + 's' : '获取验证码' }}
				</button>
			</view>

			<button class="login-button" :loading="submitting" :disabled="submitting" @click="submit">
				完成绑定并登录
			</button>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { sendVerificationCode, bindWechatPhone } from '../../api/auth.uts'
	import { setSession } from '../../stores/auth.uts'
	import { requestLocationAfterLogin } from '../../utils/location.uts'

	const phone = ref('')
	const code = ref('')
	const sending = ref(false)
	const submitting = ref(false)
	const countdown = ref(0)
	let timer : number | null = null
	let pendingToken = ''
	let redirect = '/pages/jobs/index'

	onLoad((options : UTSJSONObject) => {
		const tokenValue = options['pending_token'] as string | null
		if (tokenValue != null && tokenValue != '') {
			const decoded = decodeURIComponent(tokenValue)
			if (decoded != null) pendingToken = decoded
		}
		const redirectValue = options['redirect'] as string | null
		if (redirectValue != null && redirectValue != '') {
			const decoded = decodeURIComponent(redirectValue)
			if (decoded != null) redirect = decoded
		}
	})

	onUnmounted(() => {
		if (timer != null) clearInterval(timer!)
	})

	function validPhone() : boolean {
		return /^1\d{10}$/.test(phone.value)
	}

	function showError(message : string) {
		uni.showToast({ title: message, icon: 'none' })
	}

	function errorMessage(error : any | null, fallback : string) : string {
		if (error == null) return fallback
		const cause = error as Error
		if (cause.message == '') return fallback
		return cause.message
	}

	function sendCode() {
		if (!validPhone()) {
			showError('请输入正确的手机号')
			return
		}
		sending.value = true
		sendVerificationCode('phone', phone.value, 'bind').then(() => {
			countdown.value = 60
			timer = setInterval(() => {
				countdown.value--
				if (countdown.value <= 0 && timer != null) {
					clearInterval(timer!)
					timer = null
				}
			}, 1000)
			uni.showToast({ title: '验证码已发送', icon: 'success' })
			sending.value = false
		}).catch((error : any | null) => {
			showError(errorMessage(error, '验证码发送失败'))
			sending.value = false
		})
	}

	function submit() {
		if (pendingToken == '') {
			showError('登录信息已过期，请重新使用微信登录')
			return
		}
		if (!validPhone()) {
			showError('请输入正确的手机号')
			return
		}
		if (!/^\d{6}$/.test(code.value)) {
			showError('请输入6位验证码')
			return
		}

		submitting.value = true
		bindWechatPhone(pendingToken, phone.value, code.value).then((result) => {
			setSession(result)
			requestLocationAfterLogin()
			uni.showToast({ title: '登录成功', icon: 'success' })
			setTimeout(() => {
				uni.reLaunch({ url: redirect })
			}, 300)
			submitting.value = false
		}).catch((error : any | null) => {
			showError(errorMessage(error, '绑定失败'))
			submitting.value = false
		})
	}
</script>

<style scoped>
	.login-page { flex: 1; background-color: #f3fbf7; }
	.login-header { padding: 70px 28px 28px; align-items: center; }
	.brand { width: 64px; height: 64px; border-radius: 20px; align-items: center; justify-content: center; background-color: #19a974; }
	.brand-text { color: #fff; font-size: 27px; font-weight: 700; }
	.title { margin-top: 20px; font-size: 24px; font-weight: 700; }
	.subtitle { margin-top: 8px; color: #7b8680; font-size: 13px; text-align: center; }
	.login-card { margin: 0 20px; padding: 24px; border-radius: 18px; background-color: #fff; }
	.field { height: 48px; padding: 0 14px; border-radius: 10px; background-color: #f6f7f9; font-size: 15px; }
	.code-row { margin-top: 14px; flex-direction: row; }
	.code-field { flex: 1; }
	.code-button { width: 118px; height: 48px; margin-left: 10px; padding: 0; line-height: 48px; border-radius: 10px; background-color: #eaf8f2; color: #159669; font-size: 13px; }
	.login-button { margin-top: 24px; height: 48px; line-height: 48px; border-radius: 12px; background-color: #19a974; color: #fff; font-size: 16px; font-weight: 600; }
</style>
