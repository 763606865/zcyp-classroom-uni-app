<template>
	<view class="chat-page">
		<view class="connection" :class="{ connected: connected }" @click="retryConnection">
			<text :class="connected ? 'connection-text connected-text' : 'connection-text'">{{ connected ? peerTitle : connectionText }}</text>
		</view>

		<scroll-view
			class="messages"
			scroll-y
			:scroll-into-view="scrollTarget"
			upper-threshold="30"
			@scrolltoupper="loadOlder"
		>
			<view v-if="hasMore" class="load-more" @click="loadOlder"><text class="load-more-text">{{ loadingHistory ? '加载中...' : '查看更多历史消息' }}</text></view>
			<view v-for="(item, index) in messages" :id="'message-' + index" :key="item.local_id" class="message-row" :class="{ outgoing: item.outgoing }">
				<text v-if="item.system" class="system-message">{{ item.text }}</text>
				<view v-else class="bubble" :class="{ own: item.outgoing, failed: item.failed }">
					<text class="message-text">{{ item.text }}</text>
					<text class="message-time">{{ item.time }}{{ item.failed ? ' · 发送失败' : '' }}</text>
				</view>
			</view>
			<view id="message-bottom" class="bottom-anchor"></view>
		</scroll-view>

		<view class="composer">
			<textarea
				v-model="draft"
				class="composer-input"
				auto-height
				maxlength="1000"
				:disabled="!connected"
				:placeholder="connected ? '输入消息...' : '聊天连接中...'"
				confirm-type="send"
				@confirm="send"
			/>
			<button class="send-button" :disabled="!connected || draft.trim() == ''" @click="send">发送</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { getImConversations, getImMessages, refreshImToken } from '../../../api/im.uts'
	import { closeImSocket, connectImSocket, sendImText, subscribeImConversation } from '../../../services/im-socket.uts'
	import type { ImConversation } from '../../../types/im.uts'

	type ChatItem = {
		local_id : string
		remote_id : string | null
		client_msg_id : string | null
		text : string
		time : string
		outgoing : boolean
		system : boolean
		failed : boolean
	}

	const conversationId = ref(0)
	const conversationNo = ref('')
	const peerTitle = ref('招聘沟通')
	const conversation = ref<ImConversation | null>(null)
	const ownSenderIds = ref<string[]>([])
	const messages = ref<ChatItem[]>([])
	const draft = ref('')
	const connected = ref(false)
	const subscribed = ref(false)
	const connectionText = ref('正在连接...')
	const nextCursor = ref('')
	const hasMore = ref(false)
	const loadingHistory = ref(false)
	const scrollTarget = ref('')

	function textFromAny(value : any | null, fallback : string) : string {
		if (value == null) return fallback
		if (typeof value != 'string') return fallback
		const text = value as string
		return text == '' ? fallback : text
	}

	function objectFromAny(value : any | null) : UTSJSONObject | null {
		if (value == null) return null
		const text = JSON.stringify(value)
		if (text == '') return null
		const result = JSON.parse<UTSJSONObject>(text)
		return result == null ? null : result!
	}

	function objectRowsFromAny(value : any | null) : UTSJSONObject[] {
		if (value == null) return []
		const rows = JSON.parse<UTSJSONObject[]>(JSON.stringify(value))
		return rows == null ? [] : rows!
	}

	function nullableTextFromAny(value : any | null) : string | null {
		const text = textFromAny(value, '')
		return text == '' ? null : text
	}

	function errorMessage(error : any | null, fallback : string) : string {
		return fallback
	}

	function nowTime() : string {
		const date = new Date()
		return `${date.getHours()}`.padStart(2, '0') + ':' + `${date.getMinutes()}`.padStart(2, '0')
	}

	function formatTime(value : string | null) : string {
		if (value == null || value == '') return nowTime()
		const date = new Date(value)
		return `${date.getHours()}`.padStart(2, '0') + ':' + `${date.getMinutes()}`.padStart(2, '0')
	}

	function isDuplicate(next : ChatItem) : boolean {
		return messages.value.some((item) : boolean => {
			if (next.remote_id != null && item.remote_id == next.remote_id) return true
			if (next.client_msg_id != null && item.client_msg_id == next.client_msg_id) return true
			return false
		})
	}

	function scrollToBottom() {
		scrollTarget.value = ''
		nextTick(() => { scrollTarget.value = 'message-bottom' })
	}

	function normalizeMessage(raw : UTSJSONObject) : ChatItem {
		const type = textFromAny(raw['message_type'], 'text')
		const content = objectFromAny(raw['content'])
		let text = ''
		if (type == 'text') text = content == null ? '' : textFromAny(content!['text'], '')
		else if (type == 'emoji') text = content == null ? '' : textFromAny(content!['emoji'], '')
		else if (type == 'biz_card' || type == 'business_card') {
			if (content == null) {
				text = '[业务消息]'
			} else {
				const title = textFromAny(content!['title'], '')
				text = title != '' ? title : textFromAny(content!['summary'], '[业务消息]')
			}
		}
		else if (type == 'interaction_request') text = content == null ? '[互动请求]' : textFromAny(content!['title'], '[互动请求]')
		else if (type == 'image') text = '[图片]'
		else text = '[消息]'
		const sender = textFromAny(raw['sender_user_id'], '')
		const messageNo = textFromAny(raw['message_no'], '')
		const rawId = textFromAny(raw['id'], '')
		const localId = messageNo != '' ? messageNo : (rawId != '' ? rawId : `${Date.now()}`)
		const remoteId = messageNo != '' ? messageNo : rawId
		return {
			local_id: localId,
			remote_id: remoteId == '' ? null : remoteId,
			client_msg_id: nullableTextFromAny(raw['client_msg_id']),
			text: text,
			time: formatTime(nullableTextFromAny(raw['created_at'])),
			outgoing: sender != '' && ownSenderIds.value.indexOf(sender) >= 0,
			system: type == 'system_notice',
			failed: false
		}
	}

	function applyHistory(payload : UTSJSONObject, prepend : boolean) {
		let rows : UTSJSONObject[] = []
		if (payload['data'] != null) {
			rows = objectRowsFromAny(payload['data'])
		} else if (payload['items'] != null) {
			rows = objectRowsFromAny(payload['items'])
		}
		const normalized = rows.slice().reverse().map((item) : ChatItem => normalizeMessage(item))
			.filter((item) : boolean => !isDuplicate(item))
		messages.value = prepend ? normalized.concat(messages.value) : normalized
		nextCursor.value = textFromAny(payload['next_cursor'], '')
		hasMore.value = payload['has_more'] == true || nextCursor.value != ''
		if (!prepend) scrollToBottom()
	}

	function resolveOwnSenderIds() {
		if (conversation.value == null) return
		const otherIds : number[] = conversation.value!.other_participants.map((item) : number => item.id)
		ownSenderIds.value = conversation.value!.participants
			.filter((item) : boolean => otherIds.indexOf(item.id) < 0 && item.im_user_id != null)
			.map((item) : string => item.im_user_id!)
	}

	function handleSocketPayload(payload : any) {
		const body = objectFromAny(payload)
		if (body == null) return
		const action = textFromAny(body['action'], '')
		if (action == 'subscribed') {
			subscribed.value = true
			return
		}
		if (action == 'error') {
			uni.showToast({ title: textFromAny(body['error'], '消息发送失败'), icon: 'none' })
			return
		}
		const message = objectFromAny(body['message'])
		if (action != 'message' || message == null) return
		const clientId = textFromAny(message!['client_msg_id'], '')
		if (clientId != '') {
			const optimistic = messages.value.find((item) : boolean => item.client_msg_id == clientId)
			if (optimistic != null) {
				const messageNo = textFromAny(message!['message_no'], '')
				optimistic!.remote_id = messageNo != '' ? messageNo : textFromAny(message!['id'], '')
				optimistic!.failed = false
				return
			}
		}
		const item = normalizeMessage(message!)
		if (!isDuplicate(item)) {
			messages.value.push(item)
			scrollToBottom()
		}
	}

	function connect() {
		connectionText.value = '正在获取聊天凭证...'
		refreshImToken().then((token) => {
			if (token == '') throw new Error('IM Token 为空')
			connectionText.value = '正在连接...'
			connectImSocket(token, {
				onConnected: () => {
					connected.value = true
					connectionText.value = '已连接'
					subscribeImConversation(conversationNo.value)
				},
				onMessage: (payload : any) => handleSocketPayload(payload),
				onError: (message : string) => {
					connectionText.value = message
					connected.value = false
				},
				onClosed: () => {
					connectionText.value = '连接已断开，点击顶部重试'
					connected.value = false
					subscribed.value = false
				}
			})
		}).catch((error : any | null) => {
			connectionText.value = errorMessage(error, '聊天连接失败')
		})
	}

	function retryConnection() {
		if (!connected.value) connect()
	}

	function initialize() {
		getImConversations().then((conversations) => {
			const current = conversations.find((item) : boolean => item.id == conversationId.value)
			conversation.value = current == null ? null : current
			resolveOwnSenderIds()
			getImMessages(conversationId.value).then((payload) => {
				applyHistory(payload, false)
			}).catch((error : any | null) => {
				uni.showToast({ title: errorMessage(error, '历史消息加载失败'), icon: 'none' })
			})
		}).catch((error : any | null) => {
			uni.showToast({ title: errorMessage(error, '会话加载失败'), icon: 'none' })
		})
		connect()
	}

	function loadOlder() {
		if (!hasMore.value || loadingHistory.value) return
		loadingHistory.value = true
		getImMessages(conversationId.value, nextCursor.value).then((payload) => {
			applyHistory(payload, true)
			loadingHistory.value = false
		}).catch((error : any | null) => {
			uni.showToast({ title: errorMessage(error, '历史消息加载失败'), icon: 'none' })
			loadingHistory.value = false
		})
	}

	function send() {
		const text = draft.value.trim()
		if (text == '' || !connected.value) return
		const clientId = `client_${Date.now()}_${Math.floor(Math.random() * 100000)}`
		const item : ChatItem = {
			local_id: clientId,
			remote_id: null,
			client_msg_id: clientId,
			text: text,
			time: nowTime(),
			outgoing: true,
			system: false,
			failed: false
		}
		messages.value.push(item)
		draft.value = ''
		const sent = sendImText(conversationNo.value, text, clientId)
		if (!sent) item.failed = true
		scrollToBottom()
	}

	onLoad((options : UTSJSONObject) => {
		conversationId.value = parseInt(options['id'] as string)
		const noValue = options['no'] as string | null
		const decodedNo = noValue == null ? null : decodeURIComponent(noValue)
		conversationNo.value = decodedNo == null ? '' : decodedNo
		const titleValue = options['title'] as string | null
		const decodedTitle = titleValue == null ? null : decodeURIComponent(titleValue)
		peerTitle.value = decodedTitle == null || decodedTitle == '' ? '招聘沟通' : decodedTitle
		uni.setNavigationBarTitle({ title: peerTitle.value })
		initialize()
	})

	onUnload(() => closeImSocket())
</script>

<style scoped>
	.chat-page { flex: 1; background-color: #f4f5f7; }
	.connection { height: 30px; align-items: center; justify-content: center; background-color: #fff5df; }
	.connection-text { color: #9a6b1f; font-size: 11px; }
	.connected { background-color: #eaf8f2; }
	.connected-text { color: #64716a; }
	.messages { flex: 1; padding: 12px 14px; }
	.load-more { padding: 8px 0 16px; align-items: center; }
	.load-more-text { color: #8a9099; font-size: 11px; }
	.message-row { margin-bottom: 13px; flex-direction: row; justify-content: flex-start; }
	.outgoing { justify-content: flex-end; }
	.bubble { max-width: 286px; padding: 11px 13px 7px; border-radius: 4px 15px 15px 15px; background-color: #fff; }
	.message-text { color: #24292d; font-size: 14px; line-height: 21px; }
	.own { border-radius: 15px 4px 15px 15px; background-color: #bff1d9; }
	.failed { border: 1px solid #e86a6a; }
	.message-time { margin-top: 4px; text-align: right; color: #8a9298; font-size: 9px; }
	.system-message { width: 100%; text-align: center; color: #92989e; font-size: 11px; }
	.bottom-anchor { height: 12px; }
	.composer { padding: 9px 10px 16px; flex-direction: row; align-items: flex-end; border-top: 1px solid #e7e9ec; background-color: #fff; }
	.composer-input { flex: 1; min-height: 40px; max-height: 100px; padding: 9px 12px; border-radius: 10px; background-color: #f3f4f6; font-size: 14px; }
	.send-button { width: 66px; height: 40px; margin-left: 9px; padding: 0; line-height: 40px; border-radius: 10px; color: #fff; background-color: #19a974; font-size: 13px; }
</style>
