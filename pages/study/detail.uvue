<template>
	<RcNavBar title="课程学习" :show-back="true" />
	<scroll-view class="page">
		<view v-if="loading" class="state"><text>正在加载课程...</text></view>
		<view v-else-if="detail == null" class="state"><text>{{ errorText }}</text><text class="retry" @click="load">重新加载</text></view>
		<view v-else>
			<view class="course-head"><image v-if="detail!.course.cover != null" class="head-cover" :src="detail!.course.cover!" mode="aspectFill" /><view class="head-shade"><text class="course-title">{{ detail!.course.title }}</text><text class="course-meta">{{ detail!.summary.completed_lessons }}/{{ detail!.summary.total_lessons }} 课时已完成</text></view></view>
			<view class="progress-card"><view class="progress-head"><text class="progress-title">课程进度</text><text class="progress-number">{{ detail!.enrollment.progress }}%</text></view><view class="progress-track"><view class="progress-value" :style="{ width: detail!.enrollment.progress + '%' }" /></view><text class="continue-tip">{{ continueText }}</text></view>
			<view class="actions"><view class="action" @click="toggleFavorite"><text class="action-icon" :class="{ selected: interactions.favorited }">{{ interactions.favorited ? '★' : '☆' }}</text><text>{{ interactions.favorite_count }} 收藏</text></view><view class="action" @click="toggleLike"><text class="action-icon" :class="{ selected: interactions.liked }">♡</text><text>{{ interactions.like_count }} 点赞</text></view><view class="action" @click="shareCourse"><text class="action-icon">↗</text><text>{{ interactions.share_count }} 分享</text></view></view>

			<view class="section"><text class="section-title">课程目录</text>
				<view v-for="chapter in detail!.chapters" :key="chapter.id" class="chapter"><text class="chapter-title">{{ chapter.title }}</text><text v-if="chapter.summary != null" class="chapter-summary">{{ chapter.summary }}</text><view v-for="lesson in chapter.lessons" :key="lesson.id" class="lesson" @click="openLesson(lesson)"><view class="lesson-index"><text>{{ lesson.sort }}</text></view><view class="lesson-main"><text class="lesson-title">{{ lesson.title }}</text><text class="lesson-meta">{{ lessonType(lesson.type) }} · {{ durationText(lesson.duration_seconds) }}</text></view><text class="lesson-status" :class="{ done: lesson.progress.progress >= 100 }">{{ lesson.progress.progress >= 100 ? '已完成' : (lesson.progress.progress > 0 ? lesson.progress.progress + '%' : '开始') }} ›</text></view></view>
				<view v-if="detail!.ungrouped_lessons.length > 0" class="chapter"><text class="chapter-title">其他课时</text><view v-for="lesson in detail!.ungrouped_lessons" :key="lesson.id" class="lesson" @click="openLesson(lesson)"><view class="lesson-index"><text>{{ lesson.sort }}</text></view><view class="lesson-main"><text class="lesson-title">{{ lesson.title }}</text><text class="lesson-meta">{{ lessonType(lesson.type) }} · {{ durationText(lesson.duration_seconds) }}</text></view><text class="lesson-status">开始 ›</text></view></view>
			</view>

			<view class="section comments"><view class="section-head"><text class="section-title">课程评价</text><text class="rating">{{ comments.summary.average_rating }} 分 · {{ comments.summary.count }} 条</text></view><view v-if="comments.comments.data.length == 0" class="comment-empty"><text>暂无评价</text></view><view v-for="item in comments.comments.data" :key="item.id" class="comment"><view class="comment-head"><text class="comment-user">{{ item.is_anonymous ? '匿名学员' : commentName(item) }}</text><text class="stars">{{ stars(item.rating) }}</text></view><text class="comment-content">{{ item.content }}</text><text class="comment-time">{{ item.created_at }}</text></view></view>
			<view class="bottom-space" />
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getCourseComments, getCourseInteractions, getCourseProgress, recordCourseShare, setCourseFavorite, setCourseLike } from '../../api/classroom.uts'
	import RcNavBar from '../../components/RcNavBar.uvue'
	import type { CourseComment, CourseComments, CourseInteractions, CourseLesson, CourseProgressDetail } from '../../types/classroom.uts'
	const courseId = ref(0); const detail = ref<CourseProgressDetail | null>(null); const loading = ref(true); const errorText = ref('课程加载失败')
	const interactions = reactive<CourseInteractions>({ favorite_count: 0, like_count: 0, share_count: 0, favorited: false, liked: false })
	const comments = reactive<CourseComments>({ summary: { count: 0, average_rating: 0 }, comments: { data: [] } })
	const continueText = computed(() : string => detail.value == null || detail.value!.summary.continue_lesson_id == null ? '课程已全部完成' : '继续完成下一课时，保持学习节奏')
	onLoad((options : UTSJSONObject) => { const value = options['id'] as string | null; courseId.value = value == null ? 0 : parseInt(value); load() })
	function load() { if (courseId.value <= 0) { loading.value = false; errorText.value = '课程参数无效'; return }; loading.value = true; getCourseProgress(courseId.value).then((data) => { detail.value = data; loading.value = false }).catch(() => { detail.value = null; loading.value = false }); loadInteractions(); loadComments() }
	function loadInteractions() { getCourseInteractions(courseId.value).then((data) => { interactions.favorite_count = data.favorite_count; interactions.like_count = data.like_count; interactions.share_count = data.share_count; interactions.favorited = data.favorited; interactions.liked = data.liked }).catch(() => {}) }
	function loadComments() { getCourseComments(courseId.value).then((data) => { comments.summary = data.summary; comments.comments = data.comments }).catch(() => {}) }
	function toggleFavorite() { setCourseFavorite(courseId.value, !interactions.favorited).then(() => loadInteractions()).catch(() => uni.showToast({ title:'操作失败', icon:'none' })) }
	function toggleLike() { setCourseLike(courseId.value, !interactions.liked).then(() => loadInteractions()).catch(() => uni.showToast({ title:'操作失败', icon:'none' })) }
	function shareCourse() { uni.setClipboardData({ data: `https://zcyp-classroom.jxhrm.com/courses/${courseId.value}`, success:() => { recordCourseShare(courseId.value).then(() => loadInteractions()).catch(() => {}); uni.showToast({ title:'课程链接已复制', icon:'success' }) } }) }
	function openLesson(lesson : CourseLesson) { if (lesson.type == 'live' && lesson.live_sessions.length > 0) { uni.navigateTo({ url:`/pages/study/live?id=${lesson.live_sessions[0].id}` }); return }; if (lesson.type == 'video') { uni.navigateTo({ url:`/pages/study/video?courseId=${courseId.value}&lessonId=${lesson.id}` }); return }; if (lesson.type == 'document') { uni.showToast({ title:'课件阅读页面即将开放', icon:'none' }); return }; uni.showModal({ title:lesson.title, content:lesson.summary == null ? '该课时暂无简介' : lesson.summary!, showCancel:false }) }
	function lessonType(value : string) : string { if (value == 'video') return '视频'; if (value == 'document') return '文档'; if (value == 'live') return '直播'; if (value == 'link') return '链接'; return '图文' }
	function durationText(seconds : number) : string { if (seconds <= 0) return '时长不限'; return `${Math.ceil(seconds / 60)}分钟` }
	function commentName(item : CourseComment) : string { return item.student == null || item.student!.name == null || item.student!.name == '' ? '学员' : item.student!.name! }
	function stars(value : number) : string { let result = ''; for (let i = 0; i < 5; i++) result += i < value ? '★' : '☆'; return result }
</script>

<style scoped>
	.page{flex:1;background:#f4f7f5}.state{padding:100px 24px;align-items:center;color:#84918c}.retry{margin-top:14px;color:#176b52}.course-head{height:210px;background:#173f34}.head-cover{width:100%;height:210px}.head-shade{position:absolute;left:0;right:0;bottom:0;padding:52px 20px 20px;background:rgba(12,34,28,.68)}.course-title{color:#fff;font-size:22px;font-weight:700}.course-meta{margin-top:8px;color:#c8ddd5;font-size:12px}.progress-card{margin:14px 16px;padding:17px;border-radius:15px;background:#fff}.progress-head,.section-head{flex-direction:row;justify-content:space-between;align-items:center}.progress-title,.section-title{font-size:17px;font-weight:700;color:#243a32}.progress-number{font-size:18px;font-weight:700;color:#176b52}.progress-track{height:7px;margin-top:13px;border-radius:4px;background:#e5ece9;overflow:hidden}.progress-value{height:7px;border-radius:4px;background:#2a8a69}.continue-tip{margin-top:10px;color:#82908a;font-size:11px}.actions{margin:0 16px 14px;padding:15px 0;border-radius:15px;background:#fff;flex-direction:row}.action{flex:1;align-items:center;color:#71807a;font-size:11px}.action-icon{margin-bottom:5px;font-size:21px;color:#667871}.selected{color:#d9953b}.section{margin:0 16px 14px;padding:17px;border-radius:15px;background:#fff}.chapter{margin-top:17px}.chapter-title{font-size:15px;font-weight:700;color:#35483f}.chapter-summary{margin-top:5px;font-size:11px;color:#8b9692}.lesson{min-height:62px;margin-top:8px;padding:10px 0;flex-direction:row;align-items:center;border-bottom:1px solid #f0f2f1}.lesson-index{width:34px;height:34px;border-radius:11px;background:#e8f2ee;align-items:center;justify-content:center;color:#176b52;font-size:12px}.lesson-main{flex:1;margin-left:11px}.lesson-title{font-size:14px;color:#33453e}.lesson-meta{margin-top:5px;font-size:10px;color:#919b97}.lesson-status{font-size:11px;color:#176b52}.done{color:#8a9691}.comments{margin-bottom:20px}.rating{font-size:12px;color:#d18a32}.comment-empty{padding:25px;align-items:center;color:#99a29e;font-size:12px}.comment{padding:14px 0;border-bottom:1px solid #f0f2f1}.comment-head{flex-direction:row;justify-content:space-between}.comment-user{font-size:13px;font-weight:600;color:#3b4c45}.stars{color:#e7a43c;font-size:12px}.comment-content{margin-top:8px;font-size:13px;color:#55635e;line-height:20px}.comment-time{margin-top:7px;font-size:9px;color:#a1aaa6}.bottom-space{height:30px}
	.page{background:#F5F7FA}.course-head{background:#0F62FE}.head-shade{background:rgba(15,98,254,.72)}.course-meta{color:#fff}.retry,.progress-number,.lesson-status{color:#0F62FE}.progress-value{background:#0F62FE}.lesson-index{background:#E8F0FE;color:#0F62FE}.selected,.rating,.stars{color:#FFA500}
</style>
