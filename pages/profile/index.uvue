<template>
	<RcNavBar title="我的" />
	<scroll-view class="page" scroll-y><view class="profile-head" @click="openProfile"><view class="avatar"><image v-if="user != null && user!.avatar != null" class="avatar-image" :src="user!.avatar!" mode="aspectFill" /><text v-else>{{ user == null ? '未' : displayName.substring(0,1) }}</text></view><view class="user-info"><text class="user-name">{{ user == null ? '登录 / 注册' : displayName }}</text><text class="user-copy">{{ user == null ? '登录后查看学习档案与培训' : displayAccount }}</text></view><text class="arrow">›</text></view>
		<view class="summary"><view class="summary-item" @click="showSoon('学习时长')"><text class="summary-num">--</text><text class="summary-label">学习时长</text></view><view class="summary-item" @click="showSoon('已学课程')"><text class="summary-num">--</text><text class="summary-label">已学课程</text></view><view class="summary-item" @click="showSoon('我的证书')"><text class="summary-num">--</text><text class="summary-label">我的证书</text></view></view>
		<view class="section"><text class="section-title">我的学习</text><view class="grid"><view v-for="item in learningMenus" :key="item.label" class="grid-item" @click="handle(item.action)"><text class="grid-icon">{{ item.icon }}</text><text class="grid-label">{{ item.label }}</text></view></view></view>
		<view class="section"><text class="section-title">服务与设置</text><view class="menu-row" v-for="item in serviceMenus" :key="item.label" @click="handle(item.action)"><text class="menu-icon">{{ item.icon }}</text><text class="menu-label">{{ item.label }}</text><text class="arrow">›</text></view></view>
		<text class="version">中测培训 · {{ version }}</text><view class="bottom-space" />
	</scroll-view><RcTabBar current-path="/pages/profile/index" />
</template>
<script setup lang="uts">
	import RcTabBar from '../../components/RcTabBar.uvue'; import RcNavBar from '../../components/RcNavBar.uvue'; import { getUser } from '../../stores/auth.uts'; import type { AuthUser } from '../../types/auth.uts'
	type MenuItem = { label : string, icon : string, action : string }
	const learningMenus : MenuItem[] = [{label:'我的培训',icon:'培',action:'training'},{label:'我的班级',icon:'班',action:'class'},{label:'我的考试',icon:'考',action:'exam'},{label:'我的练习',icon:'练',action:'practice'},{label:'我的作业',icon:'作',action:'homework'},{label:'我的证书',icon:'证',action:'certificate'}]
	const serviceMenus : MenuItem[] = [{label:'支付记录',icon:'¥',action:'payments'},{label:'收藏课程',icon:'☆',action:'favorites'},{label:'帮助与反馈',icon:'?',action:'help'},{label:'设置',icon:'⚙',action:'settings'}]
	const user = ref<AuthUser | null>(null); const version = ref('1.0.0')
	const displayName = computed(() : string => user.value == null ? '' : (user.value!.real_name == null || user.value!.real_name == '' ? (user.value!.nick_name == null ? '课堂用户' : user.value!.nick_name!) : user.value!.real_name!))
	const displayAccount = computed(() : string => user.value == null ? '' : user.value!.phone)
	onShow(() => { user.value = getUser(); const v = uni.getAppBaseInfo().appVersion; version.value = v == null || v == '' ? '1.0.0' : v })
	function goLogin() { uni.navigateTo({ url: '/pages/auth/login?redirect=' + encodeURIComponent('/pages/profile/index') }) }
	function openProfile() { if (user.value == null) { goLogin(); return }; uni.navigateTo({ url:'/pages/profile/detail' }) }
	function handle(action : string) { if (user.value == null && action != 'help') { goLogin(); return }; if (action == 'settings') { openProfile(); return }; showSoon(menuName(action)) }
	function menuName(action : string) : string { for (let i = 0; i < learningMenus.length; i++) if (learningMenus[i].action == action) return learningMenus[i].label; for (let i = 0; i < serviceMenus.length; i++) if (serviceMenus[i].action == action) return serviceMenus[i].label; return '该功能' }
	function showSoon(name : string) { uni.showToast({ title: `${name}即将开放`, icon: 'none' }) }
</script>
<style scoped>
	.page{flex:1;background:#f4f7f5}.profile-head{padding:34px 20px 28px;background:#123f34;flex-direction:row;align-items:center}.avatar{width:62px;height:62px;border-radius:22px;background:#e1f1ea;color:#176b52;font-size:20px;font-weight:700;align-items:center;justify-content:center;overflow:hidden}.avatar-image{width:62px;height:62px}.user-info{flex:1;margin-left:15px}.user-name{color:#fff;font-size:21px;font-weight:700}.user-copy{margin-top:6px;color:#b7d0c7;font-size:12px}.arrow{color:#a9b7b2;font-size:24px}.summary{margin:-12px 16px 16px;padding:18px 6px;border-radius:16px;background:#fff;flex-direction:row}.summary-item{flex:1;align-items:center}.summary-num{color:#183b30;font-size:19px;font-weight:700}.summary-label{margin-top:6px;color:#84908c;font-size:11px}.section{margin:0 16px 14px;padding:17px 16px;border-radius:16px;background:#fff}.section-title{font-size:17px;font-weight:700;color:#263b34}.grid{margin-top:16px;flex-direction:row;flex-wrap:wrap}.grid-item{width:33.33%;margin-bottom:18px;align-items:center}.grid-icon{width:39px;height:39px;line-height:39px;text-align:center;border-radius:13px;background:#e8f2ee;color:#176b52;font-size:14px;font-weight:600}.grid-label{margin-top:7px;color:#43534d;font-size:12px}.menu-row{height:50px;flex-direction:row;align-items:center;border-bottom:1px solid #f0f2f1}.menu-icon{width:30px;color:#176b52;font-size:16px}.menu-label{flex:1;color:#354740;font-size:14px}.version{padding:18px;text-align:center;color:#9ba5a1;font-size:10px}.bottom-space{height:72px}
	.page{background:#F5F7FA}.profile-head{background:#0F62FE}.avatar,.grid-icon{background:#E8F0FE;color:#0F62FE}.user-copy{color:#fff}.menu-icon{color:#0F62FE}
</style>
