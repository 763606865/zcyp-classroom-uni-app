<template>
	<view class="tab-bar">
		<view
			v-for="item in items"
			:key="item.path"
			class="tab-item"
			:class="{ 'tab-item-active': currentPath == item.path, 'tab-item-switching': switchingPath == item.path }"
			hover-class="tab-item-hover"
			:hover-start-time="20"
			:hover-stay-time="120"
			@click="go(item.path)"
		>
			<text class="tab-icon" :class="{ active: currentPath == item.path }">{{ item.icon }}</text>
			<text class="tab-label" :class="{ active: currentPath == item.path }">{{ item.label }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { navigateRootPage } from '../utils/navigation.uts'

	type TabItem = {
		label : string
		icon : string
		path : string
	}

	const props = defineProps({
		currentPath: {
			type: String,
			default: ''
		}
	})

	const items : TabItem[] = [
		{ label: '首页', icon: '⌂', path: '/pages/index/index' },
		{ label: '学习', icon: '▷', path: '/pages/study/index' },
		{ label: '我的', icon: '○', path: '/pages/profile/index' }
	]
	const switchingPath = ref('')
	let navigating = false

	function go(path : string) {
		if (path == props.currentPath) return
		if (navigating) return
		navigating = true
		switchingPath.value = path
		setTimeout(() => { navigateRootPage(path); setTimeout(() => { navigating = false; switchingPath.value = '' }, 240) }, 70)
	}
</script>

<style scoped>
	.tab-bar {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		height: 58px;
		padding-bottom: env(safe-area-inset-bottom);
		background-color: #ffffff;
		border-top: 1px solid #eef0f3;
		flex-direction: row;
		z-index: 100;
	}

	.tab-item {
		flex: 1;
		height: 48px;
		margin: 5px 8px;
		border-radius: 14px;
		align-items: center;
		justify-content: center;
	}

	.tab-item-active {
		background-color: #F6F9FF;
	}

	.tab-item-hover {
		background-color: #EAF1FF;
		transform: scale(0.97);
		opacity: 0.9;
	}

	.tab-item-switching {
		background-color: #EAF1FF;
		transform: scale(0.97);
		opacity: 0.9;
	}

	.tab-icon {
		font-size: 22px;
		color: #8a9099;
		line-height: 24px;
	}

	.tab-label {
		margin-top: 2px;
		font-size: 11px;
		color: #8a9099;
	}

	.active {
		color: #0F62FE;
		font-weight: 600;
	}
</style>
