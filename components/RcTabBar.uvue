<template>
	<view class="tab-bar">
		<view
			v-for="item in items"
			:key="item.path"
			class="tab-item"
			@click="go(item.path)"
		>
			<text class="tab-icon" :class="{ active: currentPath == item.path }">{{ item.icon }}</text>
			<text class="tab-label" :class="{ active: currentPath == item.path }">{{ item.label }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { isRecruiter } from '../stores/auth.uts'

	type TabItem = {
		label : string
		icon : string
		path : string
	}

	const props = defineProps({
		currentPath: {
			type: String,
			default: ''
		}
	})

	const jobseekerItems : TabItem[] = [
		{ label: '职位', icon: '⌕', path: '/pages/jobs/index' },
		{ label: '发现', icon: '◇', path: '/pages/discover/index' },
		{ label: '消息', icon: '○', path: '/pages/messages/index' },
		{ label: '我的', icon: '□', path: '/pages/profile/index' }
	]

	const recruiterItems : TabItem[] = [
		{ label: '牛人', icon: '♙', path: '/pages/talents/index' },
		{ label: '搜索', icon: '⌕', path: '/pages/search/index' },
		{ label: '消息', icon: '○', path: '/pages/messages/index' },
		{ label: '我的', icon: '□', path: '/pages/profile/index' }
	]

	const items : TabItem[] = isRecruiter() ? recruiterItems : jobseekerItems
	let navigating = false

	function go(path : string) {
		if (path == props.currentPath) return
		if (navigating) return
		navigating = true
		uni.redirectTo({
			url: path,
			fail: () => {},
			complete: () => {
				setTimeout(() => { navigating = false }, 300)
			}
		})
	}
</script>

<style scoped>
	.tab-bar {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		height: 64px;
		background-color: #ffffff;
		border-top: 1px solid #eef0f3;
		flex-direction: row;
		z-index: 100;
	}

	.tab-item {
		flex: 1;
		align-items: center;
		justify-content: center;
	}

	.tab-icon {
		font-size: 21px;
		color: #8a9099;
		line-height: 24px;
	}

	.tab-label {
		margin-top: 2px;
		font-size: 11px;
		color: #8a9099;
	}

	.active {
		color: #19a974;
		font-weight: 600;
	}
</style>
