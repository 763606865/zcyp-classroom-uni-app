<template>
	<view class="tab-bar">
		<view
			v-for="item in items"
			:key="item.path"
			class="tab-item"
			:class="{ pressed: pressedPath == item.path }"
			@touchstart="press(item.path)"
			@touchend="release"
			@touchcancel="release"
			@click="go(item.path)"
		>
			<text class="tab-icon" :class="{ active: currentPath == item.path }">{{ item.icon }}</text>
			<text class="tab-label" :class="{ active: currentPath == item.path }">{{ item.label }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	type TabItem = {
		label : string
		icon : string
		path : string
	}

	const props = defineProps({
		currentPath: {
			type: String,
			default: ''
		}
	})

	const items : TabItem[] = [
		{ label: '首页', icon: '⌂', path: '/pages/index/index' },
		{ label: '学习', icon: '▷', path: '/pages/study/index' },
		{ label: '我的', icon: '○', path: '/pages/profile/index' }
	]
	const pressedPath = ref('')
	let navigating = false
	function press(path : string) { pressedPath.value = path }
	function release() { pressedPath.value = '' }

	function go(path : string) {
		if (path == props.currentPath) return
		if (navigating) return
		navigating = true
		uni.redirectTo({
			url: path,
			fail: () => {},
			complete: () => {
				setTimeout(() => { navigating = false }, 300)
			}
		})
	}
</script>

<style scoped>
	.tab-bar {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		height: 58px;
		padding-bottom: env(safe-area-inset-bottom);
		background-color: #ffffff;
		border-top: 1px solid #eef0f3;
		flex-direction: row;
		z-index: 100;
	}

	.tab-item {
		flex: 1;
		align-items: center;
		justify-content: center;
		transition-property: transform, opacity;
		transition-duration: 120ms;
	}

	.pressed, .tab-item:active {
		transform: scale(0.9);
		opacity: 0.68;
	}

	.tab-icon {
		font-size: 22px;
		color: #8a9099;
		line-height: 24px;
	}

	.tab-label {
		margin-top: 2px;
		font-size: 11px;
		color: #8a9099;
	}

	.active {
		color: #0F62FE;
		font-weight: 600;
	}
</style>
