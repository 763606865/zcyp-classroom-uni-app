import { request } from '../services/http.uts'
import type { AuthUser, LoginResult, SmsCodeResult, UpdateProfilePayload, UpdateUserResult } from '../types/auth.uts'

function parseLoginResult(data : any | null) : LoginResult {
	const result = JSON.parse<LoginResult>(JSON.stringify(data))
	if (result == null || result!.access_token == '') throw new Error('登录响应缺少 access_token')
	return result!
}

function parseAuthUser(data : any | null) : AuthUser {
	const user = JSON.parse<AuthUser>(JSON.stringify(data))
	if (user == null) throw new Error('用户响应解析失败')
	return user!
}

export function sendSmsCode(phone : string) : Promise<SmsCodeResult> {
	return request<SmsCodeResult>('/api/auth/sms-code', 'POST', { phone: phone }, false)
}

export function phoneLogin(phone : string, code : string) : Promise<LoginResult> {
	return request<UTSJSONObject>('/api/auth/login', 'POST', {
		phone: phone,
		code: code,
		device_name: '中测培训'
	}, false).then((data : UTSJSONObject) : LoginResult => parseLoginResult(data))
}

export function getMe() : Promise<AuthUser> {
	return request<UTSJSONObject>('/api/me', 'GET').then((data : UTSJSONObject) : AuthUser => parseAuthUser(data['user']))
}

export function updateProfile(payload : UpdateProfilePayload) : Promise<UpdateUserResult> {
	return request<UpdateUserResult>('/api/user', 'PATCH', payload)
}

export function sendChangePhoneCode(phone : string) : Promise<SmsCodeResult> {
	return request<SmsCodeResult>('/api/user/phone/sms-code', 'POST', { phone: phone })
}

export function changePhone(phone : string, code : string) : Promise<UpdateUserResult> {
	return request<UpdateUserResult>('/api/user/phone', 'PATCH', { phone: phone, code: code })
}
