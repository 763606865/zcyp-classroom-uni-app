import { request } from '../services/http.uts'
import type { ImChatroomResult, ImConfig } from '../types/im.uts'

export function bootstrapIm() : Promise<ImConfig> {
	return request<UTSJSONObject>('/api/im/bootstrap', 'POST', {}).then((data : UTSJSONObject) : ImConfig => {
		const config = JSON.parse<ImConfig>(JSON.stringify(data))
		if (config == null) throw new Error('IM 凭证解析失败')
		return config!
	})
}

export function enterCourseChatroom(courseId : number) : Promise<ImChatroomResult> {
	return request<UTSJSONObject>(`/api/me/courses/${courseId}/chatroom`, 'POST', {}).then((data : UTSJSONObject) : ImChatroomResult => {
		// 诊断日志：输出进群原始响应，用于确认 conversation_id / send_event 等字段是否存在
		console.log(`IM 进群原始响应：${JSON.stringify(data)}`)
		const room = JSON.parse<ImChatroomResult>(JSON.stringify(data))
		if (room == null) throw new Error('聊天室响应解析失败')
		return room!
	})
}
