import { API_BASE_URL } from '../config/env.uts'
import { getToken } from '../stores/auth.uts'

function responseMessage(body : UTSJSONObject | null, fallback : string) : string {
	if (body == null) return fallback
	const data = body['data'] as UTSJSONObject | null
	const dataMessage = data == null ? null : (data['message'] as string | null)
	if (dataMessage != null && dataMessage != '') return dataMessage
	const message = body['message'] as string | null
	return message == null || message == '' ? fallback : message
}

export function uploadAvatar(filePath : string) : Promise<string> {
	return new Promise<string>((resolve, reject) => {
		const token = getToken()
		const header = token == '' ? {} as UTSJSONObject : { 'Authorization': `Bearer ${token}` } as UTSJSONObject
		uni.uploadFile({
			url: `${API_BASE_URL}/api/files/upload`,
			filePath: filePath,
			name: 'file',
			header: header,
			formData: { directory: 'avatar' } as UTSJSONObject,
			success: (res : UploadFileSuccess) => {
				try {
					const body = JSON.parse(res.data.trim()) as UTSJSONObject | null
					const code = body == null ? 0 : (body['code'] as number)
					if (res.statusCode < 200 || res.statusCode >= 300 || code != 200) {
						reject(new Error(responseMessage(body, '头像上传失败')))
						return
					}
					const data = body == null ? null : (body['data'] as UTSJSONObject | null)
					const file = data == null ? null : (data['file'] as UTSJSONObject | null)
					const url = file == null ? null : (file['url'] as string | null)
					if (url == null || url == '') {
						reject(new Error('头像上传响应缺少 url'))
						return
					}
					resolve(url)
				} catch (_) {
					reject(new Error('头像上传响应解析失败'))
				}
			},
			fail: (error) => {
				reject(new Error(error.errMsg))
			}
		})
	})
}
