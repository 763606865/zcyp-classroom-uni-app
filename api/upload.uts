import { API_BASE_URL } from '../config/env.uts'
import { getToken } from '../stores/auth.uts'

// 微信 chooseAvatar 拿到的只是本地临时文件路径，需上传到业务服务器换取可长期访问的 URL。
// 需要后端新增接口：POST /rc/upload/avatar（multipart 文件字段名 file），返回 { url: string }
export function uploadAvatar(filePath : string) : Promise<string> {
	return new Promise<string>((resolve, reject) => {
		const token = getToken()
		uni.uploadFile({
			url: `${API_BASE_URL}/rc/upload/avatar`,
			filePath: filePath,
			name: 'file',
			header: token == '' ? {} : { 'Authorization': `Bearer ${token}` } as UTSJSONObject,
			success: (res) => {
				try {
					const text = res.data
					const parsed = JSON.parse(text) as UTSJSONObject
					const data = parsed['data'] as UTSJSONObject
					const url = data['url'] as string | null
					if (url == null || url == '') {
						reject(new Error('头像上传响应缺少 url'))
						return
					}
					resolve(url!)
				} catch (_) {
					reject(new Error('头像上传响应解析失败'))
				}
			},
			fail: (error) => {
				reject(new Error(error.errMsg))
			}
		})
	})
}
