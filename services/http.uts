import { API_BASE_URL, REQUEST_TIMEOUT } from '../config/env.uts'
import { LOGIN_PATH } from '../config/routes.uts'
import { clearSession, getToken } from '../stores/auth.uts'

function fallbackMessage(value : string | null, fallback : string) : string {
	return value == null || value == '' ? fallback : value
}

export function getClientHeaders() : UTSJSONObject {
	const app = uni.getAppBaseInfo()
	const device = uni.getDeviceInfo()
	let deviceId = uni.getStorageSync('classroom_device_id') as string
	if (deviceId == null || deviceId == '') {
		deviceId = `${Date.now()}-${Math.floor(Math.random() * 1000000)}`
		uni.setStorageSync('classroom_device_id', deviceId)
	}
	// 客户端类型必须按 uni-app 的编译目标判断。H5 运行在移动设备模拟器时，
	// device.platform 可能是 mac、windows 等宿主平台，不能据此推断为小程序。
	let clientType = 'web'
	let platform = 'web'
	let channel = 'web'

	// #ifdef APP-IOS
	clientType = 'app-ios'
	platform = 'ios'
	channel = 'appstore'
	// #endif

	// #ifdef APP-ANDROID
	clientType = 'app-android'
	platform = 'android'
	channel = 'official'
	// #endif

	// #ifdef APP-HARMONY
	clientType = 'app-harmony'
	platform = 'harmony'
	channel = 'official'
	// #endif

	// #ifdef MP-WEIXIN
	clientType = 'mini-program'
	platform = 'wechat'
	channel = 'wechat'
	// #endif

	// #ifdef MP-ALIPAY
	clientType = 'mini-program'
	platform = 'alipay'
	channel = 'alipay'
	// #endif

	// #ifdef MP-BAIDU
	clientType = 'mini-program'
	platform = 'baidu'
	channel = 'baidu'
	// #endif

	// #ifdef MP-TOUTIAO
	clientType = 'mini-program'
	platform = 'toutiao'
	channel = 'toutiao'
	// #endif
	return {
		'Accept': 'application/json',
		'Content-Type': 'application/json',
		'X-Client-Type': clientType,
		'X-App-Version': app.appVersion == null ? '1.0.0' : app.appVersion,
		'X-App-Build': app.appVersionCode == null ? '100000' : `${app.appVersionCode}`,
		'X-Platform': platform,
		'X-OS-Version': device.osVersion == null ? '' : device.osVersion,
		'X-Device-ID': deviceId,
		'X-Channel': channel
	} as UTSJSONObject
}

export function request<T>(path : string, method : RequestMethod = 'GET', data : any | null = null, requireAuth : boolean = true) : Promise<T> {
	return new Promise<T>((resolve, reject) => {
		const token = getToken()
		const headers = getClientHeaders()
		if (token != '') {
			headers['Authorization'] = `Bearer ${token}`
		}

		uni.request({
			url: `${API_BASE_URL}${path}`,
			method: method,
			data: data,
			header: headers,
			timeout: REQUEST_TIMEOUT,
			success: (response) => {
				const statusCode = response.statusCode
				if (statusCode == 401) {
					clearSession()
					if (requireAuth) {
						uni.navigateTo({ url: LOGIN_PATH })
					}
					reject(new Error('登录状态已失效，请重新登录'))
					return
				}
				if (statusCode == 426) {
					reject(new Error('客户端版本过低，请升级后继续使用'))
					return
				}

				const body = response.data as UTSJSONObject
				const code = body['code'] as number
				if (statusCode < 200 || statusCode >= 300 || code != 200) {
					reject(new Error(fallbackMessage(body['message'] as string | null, '请求失败，请稍后重试')))
					return
				}
				resolve(body['data'] as T)
			},
			fail: (error) => {
				reject(new Error(fallbackMessage(error.errMsg, '网络连接失败')))
			}
		})
	})
}
